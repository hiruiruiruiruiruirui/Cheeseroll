FROM python:3.11-slim

# Install only essential system deps (skip Chromium for Railway - use lightweight wkhtmltopdf or client-side)
RUN apt-get update && apt-get install -y \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python dependencies
COPY requirements-core.txt .
ENV PIP_REQUIRE_HASHES=false
RUN pip install --no-cache-dir --retries 10 --timeout 120 -r requirements-core.txt

# Copy app
COPY . .

# Upload directory
RUN mkdir -p /app/local_storage && chmod -R 777 /app/local_storage

# User
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
