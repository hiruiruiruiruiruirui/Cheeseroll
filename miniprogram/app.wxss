/* Global styles for AI Student Study Assistant */

page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f6fa;
  line-height: 1.6;
}

/* Common layout */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Card style */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* Primary button */
.btn-primary {
  background: #1a73e8;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  border: none;
}

.btn-primary:active {
  background: #1557b0;
}

/* Secondary button */
.btn-outline {
  background: transparent;
  color: #1a73e8;
  border: 2rpx solid #1a73e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  text-align: center;
}

/* Text styles */
.text-primary { color: #1a73e8; }
.text-secondary { color: #666; }
.text-muted { color: #999; }
.text-sm { font-size: 24rpx; }
.text-lg { font-size: 34rpx; }

/* Spacing */
.mt-20 { margin-top: 20rpx; }
.mb-20 { margin-bottom: 20rpx; }
.p-20 { padding: 20rpx; }

/* Flex helpers */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
}
.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}
