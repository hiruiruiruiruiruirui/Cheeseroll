<!-- 结果页：查看 AI 生成的复习笔记 + 下载 PDF -->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="empty-state">
    <text>加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="empty-state">
    <text>{{error}}</text>
    <button class="btn-primary mt-20" bindtap="loadRecord">重试</button>
  </view>

  <!-- 笔记内容 -->
  <view wx:else>
    <!-- 标题栏 -->
    <view class="card header-bar">
      <view class="record-title">{{record.title}}</view>
      <view class="flex-between mt-20">
        <view class="text-sm text-muted">{{formatDate(record.created_at)}}</view>
        <view class="flex">
          <button class="btn-outline btn-sm" bindtap="downloadPdf" wx:if="{{record.status === 'completed'}}">📥 下载 PDF</button>
          <button class="btn-outline btn-sm" style="margin-left:16rpx" bindtap="shareRecord">🔗 分享</button>
        </view>
      </view>
    </view>

    <!-- Markdown 内容（简化渲染）-->
    <view class="card markdown-body">
      <rich-text nodes="{{markdownNodes}}"></rich-text>
    </view>

    <!-- 下载进度提示 -->
    <view wx:if="{{downloading}}" class="card download-toast">
      <text>正在准备下载链接...</text>
    </view>
  </view>
</view>
