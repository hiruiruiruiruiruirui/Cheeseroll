/* 结果页样式 */
.header-bar {
  margin-bottom: 16rpx;
}
.record-title {
  font-size: 34rpx;
  font-weight: 600;
}

.btn-sm {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* Markdown 渲染 */
.markdown-body {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  overflow-x: hidden;
}

/* Rich text overrides */
.markdown-body h1 {
  font-size: 38rpx;
  font-weight: 700;
  margin: 24rpx 0 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 3rpx solid #1a73e8;
}
.markdown-body h2 {
  font-size: 34rpx;
  font-weight: 600;
  margin: 28rpx 0 14rpx;
  color: #1a73e8;
}
.markdown-body h3 {
  font-size: 30rpx;
  font-weight: 600;
  margin: 20rpx 0 10rpx;
}
.markdown-body h4 {
  font-size: 28rpx;
  font-weight: 500;
  margin: 16rpx 0 8rpx;
}

.markdown-body p {
  margin: 8rpx 0;
}

.markdown-body ul, .markdown-body ol {
  padding-left: 32rpx;
  margin: 8rpx 0;
}

.markdown-body li {
  margin: 4rpx 0;
}

.markdown-body code {
  font-family: monospace;
  background: #f5f5f5;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #d63384;
}

.markdown-body pre {
  background: #282c34;
  color: #abb2bf;
  padding: 20rpx;
  border-radius: 8rpx;
  overflow-x: auto;
  margin: 12rpx 0;
}

.markdown-body pre code {
  background: transparent;
  color: inherit;
  padding: 0;
}

.markdown-body blockquote {
  border-left: 6rpx solid #1a73e8;
  padding: 8rpx 20rpx;
  margin: 12rpx 0;
  background: #f8f9ff;
  color: #555;
}

.markdown-body strong {
  color: #1a1a1a;
}

.markdown-body table {
  width: 100%;
  border-collapse: collapse;
  margin: 12rpx 0;
  font-size: 26rpx;
}

.markdown-body tr {
  border-bottom: 1rpx solid #eee;
}

.markdown-body td, .markdown-body th {
  padding: 12rpx 8rpx;
  text-align: left;
}

.markdown-body th {
  background: #f0f4ff;
  font-weight: 600;
}

/* 下载提示 */
.download-toast {
  text-align: center;
  background: #e3f2fd;
  color: #1a73e8;
  font-size: 28rpx;
}
