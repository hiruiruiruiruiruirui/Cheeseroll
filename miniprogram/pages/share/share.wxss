/* pages/share/share.wxss */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f6fa;
}

/* States */
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.spinner {
  width: 60rpx; height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.state-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.state-text { font-size: 28rpx; color: #999; }
.state-error { font-size: 28rpx; color: #d93025; }

/* Header */
.share-header {
  background: linear-gradient(135deg, #1a73e8, #1557b0);
  color: #fff;
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.share-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.share-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  opacity: 0.85;
}
.share-from {}
.share-date {}

/* Markdown body */
.markdown-body {
  margin-bottom: 24rpx;
  line-height: 1.8;
  font-size: 28rpx;
  color: #333;
}

/* CTA */
.cta-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #f8f9ff, #eef1ff);
}
.cta-icon { font-size: 48rpx; }
.cta-title { font-size: 28rpx; font-weight: 600; color: #333; display: block; }
.cta-desc { font-size: 24rpx; color: #888; display: block; margin-top: 4rpx; }

.btn-cta {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #1a73e8, #1557b0);
  border-radius: 44rpx;
  border: none;
  margin-bottom: 20rpx;
}
.btn-share {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #1a73e8;
  background: #fff;
  border: 2rpx solid #1a73e8;
  border-radius: 40rpx;
}
