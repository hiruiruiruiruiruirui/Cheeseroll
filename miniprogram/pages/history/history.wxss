/* pages/history/history.wxss */

.container {
  padding: 24rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 16rpx; color: #999; font-size: 28rpx; }

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #666; margin-bottom: 12rpx; }
.empty-hint { font-size: 24rpx; color: #aaa; }

.records-summary {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.record-item {
  margin-bottom: 16rpx;
  transition: background 0.2s;
}
.record-item:active {
  background: #f8f9ff;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.record-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.record-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  background: #f0f0f0;
  color: #888;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-date {
  font-size: 24rpx;
  color: #aaa;
}
.record-link {
  font-size: 24rpx;
  color: #1a73e8;
}

.load-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #aaa;
}
.load-more.end { color: #ddd; }
