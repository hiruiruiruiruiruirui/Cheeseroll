# App
APP_ENV=development
SECRET_KEY=change-me-to-a-secure-random-string-at-least-64-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/study_assistant

# Tencent COS
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=study-assistant-1234567890

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-api-key

# WeChat Mini Program
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=your-wechat-app-secret
WECHAT_MCH_ID=1234567890
WECHAT_PAY_API_KEY=your-pay-api-v3-key
WECHAT_PAY_SERIAL_NO=serial-number
WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem

# Redis
REDIS_URL=redis://redis:6379/0

# Rate Limit
RATE_LIMIT_PER_DAY=10
